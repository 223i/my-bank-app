<?xml version="1.0" encoding="UTF-8"?>
<included>
    <property name="APP_NAME" value="${spring.application.name:-application}"/>
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %5p [${APP_NAME},%X{traceId:-},%X{spanId:-}] [%thread] %logger{36} - %msg%n"/>
    
    <!-- Include Kafka appender configuration -->
    <include resource="logback-kafka-appender.xml"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <springProfile name="kubernetes">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="KAFKA"/>
        </root>
    </springProfile>

    <springProfile name="!kubernetes">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- Common loggers -->
    <logger name="com.iron" level="DEBUG"/>
    <logger name="org.springframework.web" level="INFO"/>
    <logger name="org.springframework.kafka" level="INFO"/>
    
    <!-- Prevent circular logging: silence Kafka client and logback-kafka-appender internal logs -->
    <logger name="org.apache.kafka" level="WARN"/>
    <logger name="kafka" level="WARN"/>
    <logger name="com.github.danielwegener.logback.kafka" level="WARN"/>
    <logger name="ch.qos.logback" level="WARN"/>
</included>
